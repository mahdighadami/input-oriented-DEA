}

QFrame QLabel {
    border: 2px solid #aaa;
    border-radius: 4px;
    padding: 3px;
    background-color: #fff2e6;
}

QGroupBox {
    border: 2px solid #555;
    border-radius: 8px;
    margin-top: 20px;
    padding: 10px;
    background-color: #fff2e6;
}

/* Optional: style the title of the group box */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 5px;
    color: #333;
    font-weight: bold; 
}

/* Style RadioButtons inside the GroupBox */
QGroupBox QRadioButton {
    border: 2px solid #aaa;
    border-radius: 4px;
    padding: 3px;
    background-color: #fff2e6;
}

/* Style SpinBox inside the GroupBox */
QSpinBox {
    background-color: #fff2e6;
}

QPushButton {
    background-color: #b5e7a0;
    border: 2px solid #333;
    border-radius: 6px;
    padding: 6px 12px;
    color: #333;
}

/* Hover effect */
QPushButton:hover {
    background-color: #a2d891;  /* Slightly darker green */
    border-color: #222;         /* Darker border on hover (optional) */
}

/* Pressed effect */
QPushButton:pressed {
    background-color: #8fcf82;  /* Deeper green */
    border-color: #111;
}
</string>
